DATABASE_URL=file:./data/ikizen.db

# Better Auth. In development both fall back to safe local defaults.
# In production the server refuses to start without a unique secret of at least 32 characters
# (generate one with `openssl rand -base64 32`). BETTER_AUTH_URL is the public origin of the app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
